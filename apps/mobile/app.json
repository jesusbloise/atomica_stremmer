{
  "expo": {
    "name": "Atomica Stock Library",
    "slug": "atomica-stremmer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/favicon-0.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tv.atomica.stremmer"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "tv.atomica.stremmer"
    },
    "web": {
      "favicon": "./assets/atomica-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-video",
      "expo-sharing",
      "@config-plugins/react-native-pdf"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "632540d2-8a48-48a5-a994-ebbb8f95a622"
      }
    },
    "owner": "chuo"
  }
}
